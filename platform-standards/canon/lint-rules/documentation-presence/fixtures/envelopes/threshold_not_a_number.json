{
  "schema_version": 1,
  "kind": "policy-input/documentation-presence",
  "repository": {
    "path": ".",
    "name": null
  },
  "applicability": {
    "root_makefile": true,
    "python_files": true,
    "pyproject": true
  },
  "makefile_path": "Makefile",
  "lint_target": true,
  "reachable_targets": [
    "lint",
    "interrogate"
  ],
  "reachability_resolved": true,
  "interrogate_elsewhere": [],
  "runs": [
    {
      "target": "interrogate",
      "line": 10,
      "command": "interrogate -vv --fail-under high pkg scripts tests .github/scripts",
      "resolved": true,
      "paths": [
        "pkg",
        "scripts",
        "tests",
        ".github/scripts"
      ],
      "fail_under": "high",
      "verbose": 2,
      "config": null,
      "excludes": [],
      "ignores": [],
      "guarded": true
    }
  ],
  "configs": [
    {
      "path": "pyproject.toml",
      "table": {},
      "error": null
    }
  ],
  "python_files": [
    ".github/scripts/helper.py",
    "pkg/__init__.py",
    "pkg/core.py",
    "scripts/tool.py",
    "tests/test_core.py"
  ]
}
