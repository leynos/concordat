{
  "schema_version": 1,
  "kind": "policy-input/markdown-formatting-baseline",
  "repository": {
    "path": ".",
    "name": null
  },
  "applicability": {
    "markdown_files": false,
    "root_makefile": false,
    "markdownlint_config": false,
    "workflows_dir": true
  },
  "makefile": null,
  "markdownlint": null,
  "alternate_markdownlint_configs": [],
  "workflows": [
    {
      "path": ".github/workflows/ci.yml",
      "parsed": {
        "name": "CI",
        "on": {
          "push": {
            "branches": [
              "main"
            ]
          },
          "pull_request": null
        },
        "jobs": {
          "lint-test": {
            "runs-on": "ubuntu-latest",
            "steps": [
              {
                "name": "Check out repository",
                "uses": "actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0"
              },
              {
                "name": "Check formatting",
                "run": "make check-fmt"
              },
              {
                "name": "Lint Markdown",
                "uses": "DavidAnson/markdownlint-cli2-action@21c1be1b93ad9ed58fa840aacc3f279cde2a72ff",
                "with": {
                  "globs": "**/*.md"
                }
              }
            ]
          }
        }
      },
      "error": null
    }
  ],
  "action_pins": {
    "21c1be1b93ad9ed58fa840aacc3f279cde2a72ff": {
      "object_type": "commit",
      "commit": "21c1be1b93ad9ed58fa840aacc3f279cde2a72ff",
      "error": null
    }
  }
}
