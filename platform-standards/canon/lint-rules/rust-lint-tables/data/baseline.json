      "little_endian_bytes": {
        "level": "deny"
      },
      "big_endian_bytes": {
        "level": "deny"
      },
      "let_underscore_must_use": {
        "level": "deny"
      },
      "or_fun_call": {
        "level": "deny"
      },
      "option_if_let_else": {
        "level": "deny"
      },
      "self_named_module_files": {
        "level": "deny"
      },
      "shadow_reuse": {
        "level": "deny"
      },
