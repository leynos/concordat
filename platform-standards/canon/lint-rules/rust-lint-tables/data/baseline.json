        "level": "deny"
      },
      "use_self": {
        "level": "deny"
      },
      "float_arithmetic": {
        "level": "deny"
      },
      "cast_possible_truncation": {
        "level": "deny"
      },
      "cast_possible_wrap": {
        "level": "deny"
      },
      "cast_precision_loss": {
        "level": "deny"
      },
      "lossy_float_literal": {
        "level": "deny"
      },
      "missing_const_for_fn": {
        "level": "deny"
      },
      "must_use_candidate": {
        "level": "deny"
      },
      "unused_async": {
        "level": "deny"
      },
      "missing_docs_in_private_items": {
        "level": "deny"
      },
      "missing_panics_doc": {
        "level": "deny"
      },
      "error_impl_error": {
        "level": "deny"
      },
      "result_large_err": {
        "level": "deny"
      }
    },
    "rust": {
      "unknown_lints": {
        "level": "deny"
      },
      "renamed_and_removed_lints": {
        "level": "deny"
      },
      "unsafe_code": {
        "level": "forbid"
      },
      "missing_docs": {
        "level": "deny"
      },
      "unexpected_cfgs": {
        "level": "warn"
      }
    },
    "rustdoc": {
      "missing_crate_level_docs": {
        "level": "deny"
      },
      "broken_intra_doc_links": {
        "level": "deny"
      },
      "private_intra_doc_links": {
        "level": "deny"
      },
      "bare_urls": {
        "level": "deny"
      },
      "invalid_html_tags": {
        "level": "deny"
      },
      "invalid_codeblock_attributes": {
        "level": "deny"
      },
      "unescaped_backticks": {
        "level": "deny"
      }
    },
    "cognitive": {
      "lint": "cognitive_complexity",
      "threshold": 9,
      "macro_aware_lint": "macro_aware_cognitive_complexity",
      "macro_aware_ceiling": 9
    },
    "pyo3_divergences": []
  }
