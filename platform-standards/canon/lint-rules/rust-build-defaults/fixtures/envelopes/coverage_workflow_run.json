        "linux_only": false,
        "classified": true,
        "flags": [
          "-Zthreads=8"
        ]
      },
      {
        "name": "target.cfg(target_os = \"linux\")",
        "kind": "target",
        "key": "cfg(target_os = \"linux\")",
        "linux": true,
        "linux_only": true,
