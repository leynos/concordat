{
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    "MD029": { "style": "ordered" }
  },
  "ignores": [
    "**/.venv/**",
    ".node_modules/**",
    "**/node_modules/**",
    "**/target/**",
    ".uv-cache/**",
    "**/.terraform/**",
    // Checked-in renderer output, compared byte-for-byte by the snapshot
    // tests. Reformatting it to satisfy prose rules would break the tests it
    // exists to serve.
    "tests/unit/snapshots/**"
  ]
}
